local SelectedRarity = "Basic"

PetsTab:CreateDropdown({
    Name = "Select Rarity",
    Options = RarityList,
    CurrentOption = SelectedRarity,
    Flag = "RaritySelect",
    Callback = function(value) SelectedRarity = value end,
})

local function SellSpecificPet(action, petName, rarityFolder)
    local rarityDir = PetsFolder:FindFirstChild(rarityFolder)
    if not rarityDir then return end
    local petObj = rarityDir:FindFirstChild(petName)
    if petObj then
        SellPetEvent:FireServer(action, petObj)
    end
end

local function HandleAutoDelete(rarity, useSequence)
    task.spawn(function()
        while (useSequence and ToggleStates.AutoDeleteSequence) or (not useSequence and ToggleStates.AutoDelete) do
            local targetRarities = {}

            if useSequence then
                local maxIndex = nil
                for i, r in ipairs(RarityList) do
                    if r == rarity then
                        maxIndex = i
                        break
                    end
                end
                if maxIndex then
                    for i = 1, maxIndex do
                        table.insert(targetRarities, RarityList[i])
                    end
                end
            else
                table.insert(targetRarities, rarity)
            end

            for _, currentRarity in ipairs(targetRarities) do
                local rarityDir = PetsFolder:FindFirstChild(currentRarity)
                if rarityDir then
                    local petsToSell = {}
                    for _, child in ipairs(rarityDir:GetChildren()) do
                        if child:IsA("StringValue") then
                            table.insert(petsToSell, child)
                        end
                    end

                    for _, petChild in ipairs(petsToSell) do
                        if petChild.Parent then
                            SellSpecificPet("sellPet", petChild.Name, currentRarity)
                            task.wait(0.3)
                        end
                    end
                end
                task.wait(0.8)
            end
            task.wait(1.5)
        end
    end)
end

PetsTab:CreateToggle({
    Name = "Auto Delete (Selected Rarity)",
    CurrentValue = false,
    Flag = "AutoDeleteSelected",
    Callback = function(state)
        ToggleStates.AutoDelete = state
        if state then HandleAutoDelete(SelectedRarity, false) end
    end,
})

PetsTab:CreateToggle({
    Name = "Auto Delete (Selected + Sequence)",
    CurrentValue = false,
    Flag = "AutoDeleteSequence",
    Callback = function(state)
        ToggleStates.AutoDeleteSequence = state
        if state then HandleAutoDelete(SelectedRarity, true) end
    end,
})

